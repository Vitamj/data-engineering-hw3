{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "pairs-sized",
    "namespace": "vk-hw5"
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app": "pairs-baseline"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "terminationGracePeriodSeconds": 2,
        "containers": [
          {
            "name": "pairs",
            "image": "vk-pairs:hw5",
            "imagePullPolicy": "Never",
            "args": [
              "--local"
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "1Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    }
  }
}