{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "pairs-reduce",
    "namespace": "vk-hw5"
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app": "pairs-reduce"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "terminationGracePeriodSeconds": 2,
        "containers": [
          {
            "name": "pairs",
            "image": "vk-pairs:hw5",
            "imagePullPolicy": "Never",
            "args": [
              "--parts",
              "4"
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            },
            "envFrom": [
              {
                "secretRef": {
                  "name": "s3-credentials"
                }
              }
            ],
            "env": [
              {
                "name": "S3_ENDPOINT",
                "value": "http://rustfs:9000"
              }
            ]
          }
        ]
      }
    }
  }
}