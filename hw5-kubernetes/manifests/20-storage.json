{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "vk-hw5-rustfs"
      },
      "spec": {
        "capacity": {
          "storage": "1Gi"
        },
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "vk-local",
        "hostPath": {
          "path": "/var/local/vk-hw5-rustfs",
          "type": "DirectoryOrCreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "rustfs-data",
        "namespace": "vk-hw5"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "vk-local",
        "volumeName": "vk-hw5-rustfs",
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rustfs",
        "namespace": "vk-hw5"
      },
      "spec": {
        "selector": {
          "app": "rustfs"
        },
        "ports": [
          {
            "port": 9000,
            "targetPort": 9000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "rustfs",
        "namespace": "vk-hw5"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "rustfs"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rustfs"
            }
          },
          "spec": {
            "initContainers": [
              {
                "name": "permissions",
                "image": "busybox:1.37",
                "command": [
                  "sh",
                  "-c",
                  "chown -R 10001:10001 /data /logs"
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "logs",
                    "mountPath": "/logs"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "rustfs",
                "image": "rustfs/rustfs:latest",
                "ports": [
                  {
                    "containerPort": 9000
                  }
                ],
                "env": [
                  {
                    "name": "RUSTFS_VOLUMES",
                    "value": "/data"
                  },
                  {
                    "name": "RUSTFS_OBS_LOG_DIRECTORY",
                    "value": "/logs"
                  },
                  {
                    "name": "RUSTFS_ACCESS_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s3-credentials",
                        "key": "S3_ACCESS_KEY"
                      }
                    }
                  },
                  {
                    "name": "RUSTFS_SECRET_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "s3-credentials",
                        "key": "S3_SECRET_KEY"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 9000
                  },
                  "periodSeconds": 2
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "logs",
                    "mountPath": "/logs"
                  }
                ],
                "imagePullPolicy": "IfNotPresent"
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "rustfs-data"
                }
              },
              {
                "name": "logs",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
}