{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "cpu-waiting",
    "namespace": "vk-hw5"
  },
  "spec": {
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 2,
    "containers": [
      {
        "name": "pairs",
        "image": "vk-pairs:hw5",
        "imagePullPolicy": "Never",
        "resources": {
          "requests": {
            "cpu": "2",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "2",
            "memory": "128Mi"
          }
        },
        "command": [
          "sh",
          "-c",
          "python pairs.py --local; sleep 300"
        ]
      }
    ]
  }
}
